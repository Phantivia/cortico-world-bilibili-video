{
  "name": "cortico-world-bilibili-video",
  "version": "0.1.1",
  "type": "module",
  "description": "Cortico World: watch a bilibili video in a logged-in browser, with frames, subtitles and the video's own danmaku delivered as events",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "bilibili",
    "video"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 5,
    "displayName": "B 站视频",
    "consoleClient": "dist/console.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:console": "node scripts/build-console.mjs",
    "prepack": "node scripts/build-console.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.5",
    "cortico": "^0.1.5",
    "esbuild": "^0.24.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
